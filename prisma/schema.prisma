// Aven Tea Empire — shareholder & content database.
//
// Provider is SQLite for local development: zero setup, a real file, real
// persistence, real constraints. To go to production on Vercel, change the
// datasource below to `provider = "postgresql"` and point DATABASE_URL at a
// hosted Postgres (Vercel Postgres, Neon, Supabase all work unchanged with
// this schema) — Vercel's serverless filesystem is read-only at runtime, so
// SQLite's on-disk file cannot be the production database there.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHAREHOLDER
  ADMIN
}

enum PaymentPlan {
  FULL
  INSTALLMENT
}

enum HoldingStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  location     String
  passwordHash String
  role         Role     @default(SHAREHOLDER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  holdings      ShareHolding[]
  applications  Application[]
  notifications Notification[]

  @@map("users")
}

/// A message to a shareholder: installment reminders, payment receipts,
/// application updates. Shown in the dashboard inbox and, when email is
/// configured, also emailed. `dedupeKey` makes every automatic reminder
/// idempotent, so the daily job can run any number of times.
model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DUE_SOON · DUE_TODAY · OVERDUE · PAYMENT_RECEIVED · REMINDER
  kind          String
  title         String
  body          String
  href          String?
  holdingId     String?
  installmentNo Int?
  dedupeKey     String    @unique
  /// SENT · FAILED · SKIPPED (no email provider configured)
  emailStatus   String    @default("SKIPPED")
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// A purchasable ownership tier. Seeded from the four categories in the
/// masterplan document (Executive / Premium / Platinum / Royal) but editable
/// from the admin panel from here on — the marketing pages should read these
/// via the API rather than the static data file once seeded.
model MembershipPlan {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  subtitle         String
  minUnits         Int
  maxUnits         Int?
  /// Per-share price when paying by instalment.
  unitPriceBDT     Int
  /// Per-share price when paying in full.
  fullPriceBDT     Int      @default(0)
  /// Down payment for the plan's package size (minUnits shares).
  downPaymentBDT   Int      @default(0)
  /// Monthly instalments after the down payment.
  installmentCount Int      @default(12)
  freeStayNights   Int
  accentColor      String
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  holdings ShareHolding[]

  @@map("membership_plans")
}

/// One shareholder's position in one plan — created the moment they commit to
/// a unit count and payment schedule, `ACTIVE` once the opening payment (or
/// full amount) clears.
model ShareHolding {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String
  plan              MembershipPlan @relation(fields: [planId], references: [id])
  units             Int
  totalAmountBDT    Int
  paymentPlan       PaymentPlan    @default(FULL)
  /// Number of scheduled payments. With a down payment, payment 1 is the
  /// down payment and the rest are equal monthly instalments.
  installmentMonths Int?
  downPaymentBDT    Int?
  status            HoldingStatus  @default(PENDING_PAYMENT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  payments Payment[]

  @@map("share_holdings")
}

/// One SSLCommerz transaction — either the single full payment, or one
/// instalment of a scheduled plan.
model Payment {
  id              String        @id @default(cuid())
  holdingId       String
  holding         ShareHolding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  amountBDT       Int
  method          String        @default("SSLCOMMERZ")
  tranId          String        @unique
  valId           String?
  installmentNo   Int           @default(1)
  status          PaymentStatus @default(PENDING)
  gatewayResponse String?
  /// Bank reference, bKash number, cheque number… for manually recorded payments.
  reference       String?
  note            String?
  /// Admin who recorded or confirmed the payment, when it didn't come through the gateway.
  recordedBy      String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

/// Contact / enquiry form submissions — replaces the console.log stub with
/// real persistence the admin panel can read.
model Inquiry {
  id        String   @id @default(cuid())
  type      String
  name      String
  email     String
  phone     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@map("inquiries")
}

/// A named, admin-replaceable asset — lets the admin panel swap a hero image
/// or render without a code deploy. `key` is the stable identifier a page
/// looks up (e.g. "home.hero", "wellness.hammam"); `url` starts as the
/// original /renders path and can be replaced with an uploaded file's URL.
model SiteAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  label     String
  updatedAt DateTime @updatedAt

  @@map("site_assets")
}

/// A potential investor captured from the website's interest form, the
/// contact form, or entered by the team — the unit of the admin CRM.
model Lead {
  id              String     @id @default(cuid())
  name            String
  email           String
  phone           String
  location        String?
  packageSlug     String?
  units           Int?
  investmentBDT   Int?
  paymentPref     String?
  message         String?
  source          String     @default("website")
  status          LeadStatus @default(NEW)
  priority        Int        @default(0)
  nextFollowUpAt  DateTime?
  lastContactedAt DateTime?
  assignedTo      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  notes LeadNote[]

  @@index([status])
  @@map("leads")
}

/// One entry on a lead's timeline: a note, a logged call/email/meeting, or a status change.
model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind       String   @default("NOTE")
  body       String
  authorName String
  createdAt  DateTime @default(now())

  @@map("lead_notes")
}

/// A formal share-purchase application with the applicant's KYC details.
/// Approval creates the ShareHolding and its instalment schedule.
model Application {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  fatherName        String?
  email             String
  phone             String
  nid               String
  dateOfBirth       String?
  address           String
  occupation        String?
  nomineeName       String?
  nomineeRelation   String?
  nomineePhone      String?
  planSlug          String
  units             Int
  paymentPlan       PaymentPlan       @default(FULL)
  installmentMonths Int?
  quotedTotalBDT    Int
  notes             String?
  status            ApplicationStatus @default(SUBMITTED)
  adminNote         String?
  reviewedBy        String?
  reviewedAt        DateTime?
  holdingId         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@map("applications")
}

/// Editable website content: one JSON document per section (hero, FAQs,
/// legal pages, contact details…), read by the public pages with the static
/// defaults in `src/data/cms-defaults.ts` as fallback.
model SiteContent {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

/// Audit trail of admin actions.
model ActivityLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("activity_log")
}
