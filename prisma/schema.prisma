// Aven Tea Empire — shareholder & content database.
//
// Production runs on MySQL (Hostinger): DATABASE_URL looks like
//   mysql://USER:PASSWORD@localhost:3306/DATABASE
// and `npm run build` creates/updates the tables and seeds the plans and
// admin account (see HOSTINGER.md). Long text columns are marked @db.Text /
// @db.MediumText because MySQL strings default to 191 characters.
//
// Local development can use a SQLite file instead: generate a copy of this
// schema with provider "sqlite" and the @db.* attributes removed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHAREHOLDER
  ADMIN
}

enum PaymentPlan {
  FULL
  INSTALLMENT
}

enum HoldingStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String
  location           String
  passwordHash       String
  role               Role     @default(SHAREHOLDER)
  /// Membership number: joining year + a running number from 2001, e.g. 20262001.
  memberNo           String?  @unique
  /// Profile photo, an uploaded image served at /media/<id>.
  photoUrl           String?  @db.Text
  /// Set when the admin issues a one-time password; cleared once the user picks their own.
  mustChangePassword Boolean  @default(false)
  /// KYC details, copied from the approved application; the admin can edit them.
  nid                String?
  nomineeName        String?
  nomineeRelation    String?
  /// Who referred the shareholder, if anyone.
  referredBy         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  holdings      ShareHolding[]
  applications  Application[]
  notifications Notification[]

  @@map("users")
}

/// A message to a shareholder: installment reminders, payment receipts,
/// application updates. Shown in the dashboard inbox and, when email is
/// configured, also emailed. `dedupeKey` makes every automatic reminder
/// idempotent, so the daily job can run any number of times.
model Notification {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// DUE_SOON · DUE_TODAY · OVERDUE · PAYMENT_RECEIVED · REMINDER
  kind          String
  title         String
  body          String    @db.Text
  href          String?   @db.Text
  holdingId     String?
  installmentNo Int?
  dedupeKey     String    @unique
  /// SENT · FAILED · SKIPPED (no email provider configured)
  emailStatus   String    @default("SKIPPED")
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// A purchasable ownership tier. Seeded from the four categories in the
/// masterplan document (Executive / Premium / Platinum / Royal) but editable
/// from the admin panel from here on — the marketing pages should read these
/// via the API rather than the static data file once seeded.
model MembershipPlan {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  subtitle         String
  minUnits         Int
  maxUnits         Int?
  /// Per-share price when paying by instalment.
  unitPriceBDT     Int
  /// Per-share price when paying in full.
  fullPriceBDT     Int      @default(0)
  /// Down payment for the plan's package size (minUnits shares).
  downPaymentBDT   Int      @default(0)
  /// Monthly instalments after the down payment.
  installmentCount Int      @default(12)
  freeStayNights   Int
  accentColor      String
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  holdings ShareHolding[]

  @@map("membership_plans")
}

/// One shareholder's position in one plan — created the moment they commit to
/// a unit count and payment schedule, `ACTIVE` once the opening payment (or
/// full amount) clears.
model ShareHolding {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String
  plan              MembershipPlan @relation(fields: [planId], references: [id])
  units             Int
  totalAmountBDT    Int
  paymentPlan       PaymentPlan    @default(FULL)
  /// Number of scheduled payments. With a down payment, payment 1 is the
  /// down payment and the rest are equal monthly instalments.
  installmentMonths Int?
  downPaymentBDT    Int?
  /// Office discount off the chart price; totalAmountBDT is already net of it.
  discountBDT       Int            @default(0)
  discountNote      String?        @db.VarChar(200)
  /// The team's own payment schedule (JSON: [{due, amountBDT, label}]); null follows the plan.
  scheduleJson      String?        @db.Text
  /// Share numbers: a holding of 5 shares gets a consecutive run, e.g. 12–16.
  shareFrom         Int?
  shareTo           Int?
  status            HoldingStatus  @default(PENDING_PAYMENT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  payments Payment[]

  @@map("share_holdings")
}

/// One SSLCommerz transaction — either the single full payment, or one
/// instalment of a scheduled plan.
model Payment {
  id              String        @id @default(cuid())
  holdingId       String
  holding         ShareHolding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  amountBDT       Int
  method          String        @default("SSLCOMMERZ")
  tranId          String        @unique
  valId           String?
  installmentNo   Int           @default(1)
  status          PaymentStatus @default(PENDING)
  gatewayResponse String?       @db.MediumText
  /// Bank reference, bKash number, cheque number… for manually recorded payments.
  /// What the money was for, as the team wrote it: "December", "Down payment"…
  label           String?       @db.VarChar(80)
  reference       String?
  note            String?       @db.Text
  /// Admin who recorded or confirmed the payment, when it didn't come through the gateway.
  recordedBy      String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

/// Contact / enquiry form submissions — replaces the console.log stub with
/// real persistence the admin panel can read.
model Inquiry {
  id        String   @id @default(cuid())
  type      String
  name      String
  email     String
  phone     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("inquiries")
}

/// A named, admin-replaceable asset — lets the admin panel swap a hero image
/// or render without a code deploy. `key` is the stable identifier a page
/// looks up (e.g. "home.hero", "wellness.hammam"); `url` starts as the
/// original /renders path and can be replaced with an uploaded file's URL.
model SiteAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String   @db.Text
  label     String
  updatedAt DateTime @updatedAt

  @@map("site_assets")
}

/// A potential investor captured from the website's interest form, the
/// contact form, or entered by the team — the unit of the admin CRM.
model Lead {
  id              String     @id @default(cuid())
  name            String
  email           String
  phone           String
  location        String?
  packageSlug     String?
  units           Int?
  investmentBDT   Int?
  paymentPref     String?
  message         String?    @db.Text
  source          String     @default("website")
  status          LeadStatus @default(NEW)
  priority        Int        @default(0)
  nextFollowUpAt  DateTime?
  lastContactedAt DateTime?
  assignedTo      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  notes LeadNote[]

  @@index([status])
  @@map("leads")
}

/// One entry on a lead's timeline: a note, a logged call/email/meeting, or a status change.
model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind       String   @default("NOTE")
  body       String   @db.Text
  authorName String
  createdAt  DateTime @default(now())

  @@map("lead_notes")
}

/// A formal share-purchase application with the applicant's KYC details.
/// Approval creates the ShareHolding and its instalment schedule.
model Application {
  id                String            @id @default(cuid())
  /// Empty until the application is approved and the applicant's account is opened.
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  fatherName        String?
  email             String
  phone             String
  nid               String
  dateOfBirth       String?
  address           String            @db.Text
  occupation        String?
  nomineeName       String?
  nomineeRelation   String?
  nomineePhone      String?
  referredBy        String?
  /// The applicant's chosen password (hashed), used when their account is opened.
  passwordHash      String?
  planSlug          String
  units             Int
  paymentPlan       PaymentPlan       @default(FULL)
  installmentMonths Int?
  quotedTotalBDT    Int
  notes             String?           @db.Text
  status            ApplicationStatus @default(SUBMITTED)
  adminNote         String?           @db.Text
  reviewedBy        String?
  reviewedAt        DateTime?
  holdingId         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@map("applications")
}

/// Editable website content: one JSON document per section (hero, FAQs,
/// legal pages, contact details…), read by the public pages with the static
/// defaults in `src/data/cms-defaults.ts` as fallback.
model SiteContent {
  key       String   @id
  value     String   @db.MediumText
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

/// Audit trail of admin actions.
model ActivityLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("activity_log")
}

/// An image uploaded in the admin panel, stored in the database itself so it
/// survives serverless deploys (Vercel's filesystem is read-only). Served at
/// /media/<id>.
model MediaFile {
  id         String   @id @default(cuid())
  filename   String   @db.VarChar(255)
  mimeType   String
  size       Int
  data       Bytes    @db.LongBlob
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@map("media_files")
}

/// A one-time code emailed for "forgot password". Only a hash of the code is
/// kept; it expires after 15 minutes and locks after 5 wrong tries.
model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("password_resets")
}

/// Hands out membership numbers one at a time: `last` is the running number
/// already used in that year (starts at 2000, so the first member is 2001).
/// Row 0 is the share-number counter: `last` is the highest share number issued.
model MemberCounter {
  year Int @id
  last Int @default(2000)

  @@map("member_counters")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// A job circular on the Careers page, written in admin → Careers.
/// `images`, `links` and `updates` are JSON arrays: image URLs (the first is
/// the cover), { label, url } buttons (apply, register, contact…; the first is
/// the main one) and recruitment notices { date, title, body, url } posted
/// after publication (shortlist, interview dates…). Line-based fields hold
/// one point per line. `circularUrl` is the official circular as a PDF.
model JobPost {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  /// Memo / reference number printed on the circular, e.g. AVEN/HR/2026/014.
  reference        String?
  department       String
  /// Job level: Management, Executive, Staff, Internship…
  level            String?
  employmentType   String           @default("Full-time")
  location         String           @default("Sreemangal, Moulvibazar")
  vacancies        Int?
  salary           String?
  experience       String?
  education        String?
  deadline         DateTime?
  summary          String           @db.Text
  description      String?          @db.MediumText
  responsibilities String?          @db.Text
  requirements     String?          @db.Text
  benefits         String?          @db.Text
  howToApply       String?          @db.Text
  images           String           @db.Text
  links            String           @db.Text
  updates          String           @db.Text
  circularUrl      String?
  circularName     String?
  contactEmail     String?
  contactPhone     String?
  status           JobStatus        @default(DRAFT)
  featured         Boolean          @default(false)
  /// Take applications (with a CV) through a form on the circular itself.
  applyOnline      Boolean          @default(true)
  publishedAt      DateTime?
  createdBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  applications     JobApplication[]

  @@index([status])
  @@map("job_posts")
}

enum CandidateStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
}

/// A job application sent from the website, with its CV. The CV is kept here,
/// not in the public media library, and only admins can open it. jobId is
/// empty for a CV sent "for future openings"; jobTitle keeps the position's
/// name even if its circular is later deleted.
model JobApplication {
  id              String          @id @default(cuid())
  jobId           String?
  job             JobPost?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobTitle        String
  name            String
  email           String
  phone           String
  address         String?
  currentPosition String?
  experience      String?
  education       String?
  expectedSalary  String?
  noticePeriod    String?
  profileUrl      String?
  coverLetter     String?         @db.Text
  cvName          String
  cvType          String
  cvSize          Int
  cvData          Bytes           @db.LongBlob
  status          CandidateStatus @default(NEW)
  rating          Int?
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([jobId])
  @@index([status])
  @@index([email])
  @@map("job_applications")
}

/// A change made in the page editor: one piece of text, or one image, swapped
/// wherever it appears on the site. `hash` is a SHA-256 of kind + original,
/// so each original is edited at most once.
model SiteEdit {
  id        String   @id @default(cuid())
  hash      String   @unique @db.VarChar(64)
  kind      String
  original  String   @db.Text
  value     String   @db.Text
  page      String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_edits")
}
